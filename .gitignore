.playwright-cli
.playwright-mcp
.playwright-profiles

vite.config.*.timestamp*
vitest.config.*.timestamp*

__screenshots__/

.nx/polygraph
# Skill benchmark workspaces: keep eval configs/scripts/reports, ignore ephemeral artifacts
.claude/skills/*-workspace/**/outputs/
# Skill snapshots (large, reproducible from git history)
.claude/skills/*-workspace/**/skill-snapshot*/
# Eval viewer HTML files (generated by skill-creator, large)
.claude/skills/*-workspace/**/*-viewer*.html
# Review HTML files (generated by skill-creator)
.claude/skills/*-workspace/**/review.html
